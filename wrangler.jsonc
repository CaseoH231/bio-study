// Cloudflare settings for Bio Study Notes as its own Worker ("bio-study").
{
  "name": "bio-study",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare's own AI models (the free note reader).
  "ai": { "binding": "AI" },
  "assets": {
    // The site: every file in this folder is served as-is (see .assetsignore for what's left out).
    "directory": ".",
    "binding": "ASSETS",
    // Only /api/... runs the Worker code (reading photos of notes).
    "run_worker_first": ["/api/*"]
  }
}
